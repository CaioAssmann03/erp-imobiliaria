# Django
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (lido pelo backend/config/settings.py)
POSTGRES_DB=erp_imobiliaria
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# Port the database is published on in YOUR computer (the compose host side). Change it when 5432 is
# taken by another Postgres; the containers keep talking to db:5432, so POSTGRES_PORT stays 5432.
# manage.py and pytest run outside Docker must use this value as their POSTGRES_PORT.
# POSTGRES_HOST_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# CORS — domínio(s) do frontend, separados por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend: o navegador só fala com o Next (mesma origem); o servidor do Next chama o Django por
# esta URL (variável só do servidor, nunca vai ao navegador).
API_INTERNAL_URL=http://localhost:8000

# Santander API de Cobrança (Sprint 4/5 — preencher quando o credenciamento voltar)
SANTANDER_CLIENT_ID=
SANTANDER_CLIENT_SECRET=
SANTANDER_CERT_PATH=

# E-mail transacional (Sprint 5)
RESEND_API_KEY=

# Company of the first administrator (id or CNPJ). Only needed when more than one company exists;
# with a single company (the one the initial migration creates) it is used automatically.
# DJANGO_SUPERUSER_COMPANY=

# Secret shared by the backend and the Next server (same value on both sides). The Next server
# uses it to tell Django the real client address; required when DEBUG=false. Generate a long random value.
INTERNAL_API_KEY=

# Where the Django Admin lives (default admin/). In production use a non-obvious path.
# ADMIN_URL=admin/
# Plain HTTP is redirected to HTTPS when DEBUG=false (SECURE_SSL_REDIRECT, default on in production);
# HSTS seconds (default 3600 in production; raise to 31536000 once the final domain exists).
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=3600

# Bucket of the payment receipts (Cloudflare R2, S3-compatible; spec 018). Without them the receipt
# endpoints answer 503. The endpoint is https://<account id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=auto
