# Django
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (lido pelo backend/config/settings.py)
POSTGRES_DB=erp_imobiliaria
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# CORS — domínio(s) do frontend, separados por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Santander API de Cobrança (Sprint 4/5 — preencher quando o credenciamento voltar)
SANTANDER_CLIENT_ID=
SANTANDER_CLIENT_SECRET=
SANTANDER_CERT_PATH=

# E-mail transacional (Sprint 5)
RESEND_API_KEY=
